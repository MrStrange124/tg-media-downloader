{
  "manifest_version": 3,
  "name": "TG Media Downloader",
  "version": "0.6.1",
  "description": "Download photos, videos and GIFs from Telegram Web A at full quality, with no download prompts.",
  "permissions": [
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TG Media Downloader"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/fetcher-main.js"
      ],
      "matches": [
        "https://web.telegram.org/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/a/*"
      ],
      "js": [
        "src/lib/naming.js",
        "src/lib/stream-url.js",
        "src/lib/range-fetch.js",
        "src/lib/dedupe.js",
        "src/lib/scroll.js",
        "src/selectors.js",
        "src/select.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": [
        "src/ui.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
